(*
   PGB-PKI regular admission - one leaked threshold share

   Purpose:
   Compromise variant of regular_2of3_baseline.pv. After the trusted lock
   boundary, the attacker learns C1's current-epoch threshold share share1(e0).
   C1's device key remains secret and the honest C1 certification service stays
   online. The leak therefore models a copied threshold share, not a complete
   takeover or shutdown of C1.

   High-level flow:
   1. Regular smartcard authorization, overlay routing, and signer-side PoP
      validation proceed as in the baseline.
   2. LockedSetup additionally publishes share1(e0), so the attacker can create
      C1 partial signatures independently of the honest C1 signer process.
   3. A valid pair12 completion must therefore still contain an independently
      validated C2 contribution; pair13 must still contain C3; pair23 remains
      fully honest and requires both C2 and C3 validation.
   4. The model checks that one leaked share, which remains below the 2-of-3
      threshold, is insufficient to bypass regular-admission authorization.

   Expected result:
   - share1(e0) is attacker-derivable, while share2(e0) and share3(e0) are not;
   - regular admission still traces to genuine smartcard authorization and PoP;
   - pair12/pair13 still require the corresponding uncompromised signer, and
     pair23 requires both uncompromised signers;
   - all six reachability canaries are intentionally reachable.

   The fully commented baseline explains the common ProVerif syntax and the
   unchanged regular-admission flow. Comments here focus on the compromise.

   Run with:

     proverif -lib common_primitives.pvl regular_2of3_leak_share1.pv
*)

(* ----------------------------------------------------------------------- *)
(* Fixed architecture instance                                              *)
(* ----------------------------------------------------------------------- *)

free net: channel.
free cardProvision: channel [private].

const pgbA: pgb.
const C1, C2, C3, O1, Dreg, Dadv: device.
const e0: epoch.

const initialSerialC1, initialSerialC2: serial.
const initialSerialC3, initialSerialO1: serial.

(* Admission authority and device private keys. *)
free skCard: skey [private].
free skC1Device: skey [private].
free skC2Device: skey [private].
free skC3Device: skey [private].
free skO1Device: skey [private].
free skDregDevice: skey [private].

(* Explicit attacker-owned key material; this is intentionally public. *)
free skAdv: skey.

(*
   Records the deliberate threshold-share disclosure. This event is only trace
   instrumentation; the actual compromise is the out(net, share1(e0)) in
   LockedSetup below.
*)
event ShareCompromised(device, epoch).

(*
   Reachability witnesses. Their secrecy is intentionally expected to fail.
   They are emitted only after the corresponding honest milestone.
*)
free reachSetup: bitstring [private].
free reachShare1Leak: bitstring [private].
free reachRepresentativeOverlayForwarding: bitstring [private].
free reachPair12MembershipAuthorized: bitstring [private].
free reachPair13MembershipAuthorized: bitstring [private].
free reachPair23MembershipAuthorized: bitstring [private].

(* ----------------------------------------------------------------------- *)
(* Security and sanity queries                                              *)
(* ----------------------------------------------------------------------- *)

(* P1: no uncompromised private key or root share is attacker-derivable. *)
query attacker(skCard).
query attacker(skC1Device).
query attacker(skC2Device).
query attacker(skC3Device).
query attacker(skO1Device).
query attacker(skDregDevice).

(* Expected false: this direct query confirms the deliberate compromise. *)
query attacker(share1(e0)).
query attacker(share2(e0)).
query attacker(share3(e0)).

(* T1: every accepted regular member has genuine smartcard authorization. *)
query G: device, D: device, PK: pkey, T: serial, S: serial, NJ: nonce;
  event(RegularMembershipAuthorized(G, D, PK, T, S, NJ))
  ==>
  event(CardAuthorized(pgbA, D, PK, T)).

(* No post-lock acceptance can precede the trusted lock boundary. *)
query G: device, D: device, PK: pkey, T: serial, S: serial, NJ: nonce;
  event(RegularMembershipAuthorized(G, D, PK, T, S, NJ))
  ==>
  event(PGBLocked(pgbA)).

(* Every validation follows cryptographic PoP verification by that signer. *)
query Ci: device, D: device, PK: pkey, T: serial,
      S: serial, E: epoch, N: nonce;
  inj-event(SignerValidated(Ci, D, PK, T, S, E, N))
  ==>
  inj-event(RegularSignerPoPVerified(Ci, D, PK, S, E, N)).

(* Honest signer executions still authenticate the candidate; this local
   correspondence does not constrain attacker-generated partials. *)
query Ci: device, D: device, PK: pkey, T: serial,
      S: serial, E: epoch, N: nonce;
  inj-event(SignerValidated(Ci, D, PK, T, S, E, N))
  ==>
  inj-event(RegularPoPProduced(D, PK, Ci, S, N)).

(* Cryptographic token validity must trace to genuine card authorization. *)
query Ci: device, D: device, PK: pkey, T: serial,
      S: serial, E: epoch, N: nonce;
  event(SignerValidated(Ci, D, PK, T, S, E, N))
  ==>
  event(CardAuthorized(pgbA, D, PK, T)).

(* No partial-signing branch may bypass its own local validation event. *)
query Ci: device, D: device, PK: pkey, S: serial, E: epoch,
      T: serial, N: nonce;
  event(PartialIssued(Ci, D, PK, S, E))
  ==>
  event(SignerValidated(Ci, D, PK, T, S, E, N)).

(*
   With share1(e0) public, the attacker can create a C1-labeled partial for an
   arbitrary body without causing C1's honest SignerValidated event. Therefore
   pair12 can require only C2's honest validation and pair13 only C3's. Pair23
   does not use the leaked share and still requires both honest validations.
*)
query G: device, D: device, PK: pkey, T: serial, S: serial, NJ: nonce,
      N2: nonce;
  event(RegularCredentialAccepted12(G, D, PK, T, S, NJ))
  ==>
  event(SignerValidated(C2, D, PK, T, S, e0, N2)).

query G: device, D: device, PK: pkey, T: serial, S: serial, NJ: nonce,
      N3: nonce;
  event(RegularCredentialAccepted13(G, D, PK, T, S, NJ))
  ==>
  event(SignerValidated(C3, D, PK, T, S, e0, N3)).

query G: device, D: device, PK: pkey, T: serial, S: serial, NJ: nonce,
      N2: nonce, N3: nonce;
  event(RegularCredentialAccepted23(G, D, PK, T, S, NJ))
  ==>
  event(SignerValidated(C2, D, PK, T, S, e0, N2)) &&
  event(SignerValidated(C3, D, PK, T, S, e0, N3)).

(* Structural nonreachability: this admission-only model has no share-
   activation service. These queries record the modeled role boundary; they
   do not test escalation against a live resharing service. *)
query E: epoch, S: serial;
  event(ShareActivated(O1, E, pkChord, S)).

query E: epoch, S: serial;
  event(ShareActivated(Dreg, E, pkChord, S)).

(* Sanity reachability: all six secrecy queries below must be false. *)
query attacker(reachSetup).
query attacker(reachShare1Leak).
query attacker(reachRepresentativeOverlayForwarding).
query attacker(reachPair12MembershipAuthorized).
query attacker(reachPair13MembershipAuthorized).
query attacker(reachPair23MembershipAuthorized).

(* ----------------------------------------------------------------------- *)
(* Honest offline card provisioning                                         *)
(* ----------------------------------------------------------------------- *)

let SmartcardAuthorize() =
  new tokenSerial: serial;
  let tokenBody: protocolMessage =
    cardTokenBody(tagCardToken, pgbA, Dreg, pk(skDregDevice), tokenSerial) in
  event CardAuthorized(pgbA, Dreg, pk(skDregDevice), tokenSerial);
  let token: admissionToken =
    makeCardToken(tokenBody, sign(tokenBody, skCard)) in
  out(cardProvision, token).

(* Candidate reveals the non-secret token only after local provisioning. *)
let CandidateStart() =
  in(cardProvision, token: admissionToken);
  new lookupId: routeid;
  event OverlayLookupRequested(Dreg, admissionService, lookupId);
  out(net,
    route(lookupId, Dreg, admissionService, O1,
      admissionInit(Dreg, pk(skDregDevice), token))).

(* ----------------------------------------------------------------------- *)
(* Untrusted logical Chord routing                                           *)
(* ----------------------------------------------------------------------- *)

(*
   Representative overlay forwarding through ordinary peer O1.
*)
let O1ForwardInitialLookup() =
  !in(net, envelope: routeEnvelope);
  let route(routeId: routeid, source: device, =admissionService, =O1,
            payload: wireMessage) = envelope in
  let admissionInit(subject: device, subjectKey: pkey,
                    token: admissionToken) = payload in
  event OverlayForwarded(O1, source, C1, admissionService, routeId);
  out(net, reachRepresentativeOverlayForwarding);
  out(net, route(routeId, source, admissionService, C1, payload)).

(* Representative signer dispatch through the same untrusted ordinary peer. *)
let O1ForwardSignerRequest() =
  !in(net, envelope: routeEnvelope);
  let route(routeId: routeid, source: device, =admissionService, =O1,
            payload: wireMessage) = envelope in
  let signerRequest(target: device, subject: device, subjectKey: pkey,
                    token: admissionToken, admissionSerial: serial) =
    payload in
  event OverlayForwarded(O1, source, target, admissionService, routeId);
  out(net, route(routeId, source, admissionService, target, payload)).

(* Destination delivery is diagnostic only; the attacker may also bypass it. *)
let DeliverAt(destination: device) =
  !in(net, envelope: routeEnvelope);
  let route(routeId: routeid, source: device, serviceTag: service,
            =destination, payload: wireMessage) = envelope in
  event OverlayDelivered(destination, serviceTag, routeId);
  out(net, payload).

(* ----------------------------------------------------------------------- *)
(* Admission coordinator and independent signers                            *)
(* ----------------------------------------------------------------------- *)

let AdmissionCoordinator() =
  !in(net, initialization: wireMessage);
  let admissionInit(subject: device, subjectKey: pkey,
                    token: admissionToken) = initialization in
  new admissionSerial: serial;
  event RegularAdmissionStarted(subject, subjectKey, admissionSerial);

  (* C1 is the contacted coordinator and receives its local request directly. *)
  out(net, signerRequest(C1, subject, subjectKey, token, admissionSerial));

  (* C2 and C3 are addressed through the representative ordinary relay O1. *)
  new routeToC2: routeid;
  event OverlayLookupRequested(C1, admissionService, routeToC2);
  out(net,
    route(routeToC2, C1, admissionService, O1,
      signerRequest(C2, subject, subjectKey, token, admissionSerial)));

  new routeToC3: routeid;
  event OverlayLookupRequested(C1, admissionService, routeToC3);
  out(net,
    route(routeToC3, C1, admissionService, O1,
      signerRequest(C3, subject, subjectKey, token, admissionSerial))).

(*
   This macro is instantiated only for C1, C2, and C3. O1 and Dreg never
   receive a thresholdShare parameter or a partial-signing continuation.
*)
let CertificationSigner(signerId: device, signerShare: thresholdShare,
                        cardAnchor: pkey) =
  !in(net, request: wireMessage);
  let signerRequest(=signerId, subject: device, subjectKey: pkey,
                    token: admissionToken, admissionSerial: serial) =
    request in

  new verifierNonce: nonce;
  out(net,
    signerChallenge(pgbA, subject, subjectKey, admissionSerial,
                    signerId, verifierNonce));

  in(net, response: wireMessage);
  let regularPoPResponse(=signerId, =subject, =subjectKey,
                         =admissionSerial, =verifierNonce,
                         popSignature: signature) = response in

  let tokenSerial: serial =
    validateCardToken(token, cardAnchor, pgbA, subject, subjectKey) in
  let checkedContext: protocolMessage =
    checkSign(popSignature, subjectKey) in
  let expectedContext: protocolMessage =
    regularPoPContext(tagRegPoP, pgbA, subject, subjectKey,
                      admissionSerial, signerId, verifierNonce) in

  if checkedContext = expectedContext then
    event RegularSignerPoPVerified(signerId, subject, subjectKey,
                                   admissionSerial, e0, verifierNonce);
    event SignerValidated(signerId, subject, subjectKey, tokenSerial,
                          admissionSerial, e0, verifierNonce);
    let certificateBody: thresholdMessage =
      regularLDevIDBody(tagRegularLDevID, pgbA, subject, subjectKey,
                        regularMember, tokenSerial, admissionSerial) in
    event PartialIssued(signerId, subject, subjectKey, admissionSerial, e0);
    out(net,
      partialResponse(signerId, subject, subjectKey, tokenSerial, admissionSerial,
                      partialSign(certificateBody, signerShare))).

(*
   The honest candidate answers each signer-specific fresh challenge. There is
   no honest Dadv responder: skAdv is already public, so the attacker can create
   Dadv PoP signatures directly. Dadv's protection in the uncompromised path is
   the missing genuine admission authorization, not inability to prove skAdv.
*)
let RegularPoPResponder() =
  !in(net, challenge: wireMessage);
  let signerChallenge(challengePgb: pgb, subject: device, subjectKey: pkey,
                      admissionSerial: serial, verifier: device,
                      verifierNonce: nonce) = challenge in
  if challengePgb = pgbA then
  if subject = Dreg then
  if subjectKey = pk(skDregDevice) then
    let proofContext: protocolMessage =
      regularPoPContext(tagRegPoP, pgbA, Dreg, pk(skDregDevice),
                        admissionSerial, verifier, verifierNonce) in
    event RegularPoPProduced(Dreg, pk(skDregDevice), verifier,
                             admissionSerial, verifierNonce);
    out(net,
      regularPoPResponse(verifier, Dreg, pk(skDregDevice),
                         admissionSerial, verifierNonce,
                         sign(proofContext, skDregDevice))).

(* ----------------------------------------------------------------------- *)
(* Public threshold combination                                             *)
(* ----------------------------------------------------------------------- *)

(*
   As in the baseline, the combiner is public and untrusted. Security therefore
   comes from which partial signatures the attacker can obtain and from the
   combine/verifyThreshold reductions in common_primitives.pvl, not from a
   trusted combination process.
*)
let CombinePair(firstSigner: device, secondSigner: device) =
  !in(net, firstMessage: wireMessage);
  let partialResponse(=firstSigner, subject: device, subjectKey: pkey,
                      tokenSerial: serial, admissionSerial: serial,
                      firstPartial: partialSignature) = firstMessage in

  in(net, secondMessage: wireMessage);
  let partialResponse(=secondSigner, =subject, =subjectKey,
                      =tokenSerial, =admissionSerial,
                      secondPartial: partialSignature) = secondMessage in

  let certificateBody: thresholdMessage =
    regularLDevIDBody(tagRegularLDevID, pgbA, subject, subjectKey,
                      regularMember, tokenSerial, admissionSerial) in
  let rootSignature: thresholdSignature =
    combine(firstPartial, secondPartial) in
  let credential: certificate =
    makeRegularCertificate(certificateBody, rootSignature) in
  let verifiedPair: signerPair =
    verifyThreshold(rootSignature, certificateBody, pkChord) in
  new completionNonce: nonce;
  out(net, credential);
  if verifiedPair = pair12 then
    (
      event RegularCredentialAccepted12(firstSigner, subject, subjectKey,
                                        tokenSerial, admissionSerial, completionNonce);
      event RegularMembershipAuthorized(firstSigner, subject, subjectKey,
                                 tokenSerial, admissionSerial, completionNonce);
      out(net, reachPair12MembershipAuthorized)
    )
  else if verifiedPair = pair13 then
    (
      event RegularCredentialAccepted13(firstSigner, subject, subjectKey,
                                        tokenSerial, admissionSerial, completionNonce);
      event RegularMembershipAuthorized(firstSigner, subject, subjectKey,
                                 tokenSerial, admissionSerial, completionNonce);
      out(net, reachPair13MembershipAuthorized)
    )
  else if verifiedPair = pair23 then
    (
      event RegularCredentialAccepted23(firstSigner, subject, subjectKey,
                                        tokenSerial, admissionSerial, completionNonce);
      event RegularMembershipAuthorized(firstSigner, subject, subjectKey,
                                 tokenSerial, admissionSerial, completionNonce);
      out(net, reachPair23MembershipAuthorized)
    ).

(* ----------------------------------------------------------------------- *)
(* Trusted locked setup                                                     *)
(* ----------------------------------------------------------------------- *)

let LockedSetup() =
  (* Public admission trust anchor passed to validators; skCard stays local. *)
  let cardAnchor: pkey = pk(skCard) in

  (*
     Initial members already possess regular root credentials at lock time. O1
     is a regular member like C1-C3, but only C1-C3 belong to the certification
     committee and hold threshold shares.
  *)
  let bodyC1: thresholdMessage =
    regularLDevIDBody(tagRegularLDevID, pgbA, C1, pk(skC1Device),
                      regularMember, initialSerialC1, initialSerialC1) in
  let bodyC2: thresholdMessage =
    regularLDevIDBody(tagRegularLDevID, pgbA, C2, pk(skC2Device),
                      regularMember, initialSerialC2, initialSerialC2) in
  let bodyC3: thresholdMessage =
    regularLDevIDBody(tagRegularLDevID, pgbA, C3, pk(skC3Device),
                      regularMember, initialSerialC3, initialSerialC3) in
  let bodyO1: thresholdMessage =
    regularLDevIDBody(tagRegularLDevID, pgbA, O1, pk(skO1Device),
                      regularMember, initialSerialO1, initialSerialO1) in

  (*
     The pre-existing credentials are instantiated with the valid C1+C2 signing
     pair. This is only a concrete witness for already-completed root issuance:
     the certificate subject need not be one of the signers, and choosing pair12
     here gives C3 and O1 no additional certification authority.
  *)
  let credentialC1: certificate =
    makeRegularCertificate(bodyC1, thresholdSig12(e0, bodyC1)) in
  let credentialC2: certificate =
    makeRegularCertificate(bodyC2, thresholdSig12(e0, bodyC2)) in
  let credentialC3: certificate =
    makeRegularCertificate(bodyC3, thresholdSig12(e0, bodyC3)) in
  let credentialO1: certificate =
    makeRegularCertificate(bodyO1, thresholdSig12(e0, bodyO1)) in

  event InitialRegularMember(C1, pk(skC1Device));
  event InitialRegularMember(C2, pk(skC2Device));
  event InitialRegularMember(C3, pk(skC3Device));
  event InitialRegularMember(O1, pk(skO1Device));
  event InitialCommitteeMember(C1, e0);
  event InitialCommitteeMember(C2, e0);
  event InitialCommitteeMember(C3, e0);
  event SetupComplete(pgbA, pkChord, cardAnchor);
  event PGBLocked(pgbA);

  (*
     COMP-C1-SHARE: copy exactly one current-epoch threshold share to the
     attacker. C1 itself remains an honest, online signer below; the attacker
     can now use the same share independently in parallel.
  *)
  event ShareCompromised(C1, e0);
  out(net, share1(e0));
  out(net, reachShare1Leak);

  (*
     Trust anchors, existing-member public keys, and their credentials are
     public. Dreg is not an existing member at lock time, so its public key is
     not separately published here; it becomes public when its token/admission
     request carrying pk(skDregDevice) is sent on net. Dadv is attacker-owned,
     so publishing pk(skAdv) is explicit but does not reveal anything new.
  *)
  out(net, cardAnchor);
  out(net, pkChord);
  out(net, pk(skC1Device));
  out(net, pk(skC2Device));
  out(net, pk(skC3Device));
  out(net, pk(skO1Device));
  out(net, pk(skAdv));
  out(net, credentialC1);
  out(net, credentialC2);
  out(net, credentialC3);
  out(net, credentialO1);
  out(net, reachSetup);

  (
    SmartcardAuthorize()
  | CandidateStart()
  | O1ForwardInitialLookup()
  | O1ForwardSignerRequest()
  | DeliverAt(C1)
  | DeliverAt(C2)
  | DeliverAt(C3)
  | AdmissionCoordinator()
  | CertificationSigner(C1, share1(e0), cardAnchor)
  | CertificationSigner(C2, share2(e0), cardAnchor)
  | CertificationSigner(C3, share3(e0), cardAnchor)
  | RegularPoPResponder()
  | CombinePair(C1, C2)
  | CombinePair(C1, C3)
  | CombinePair(C2, C3)
  ).

process LockedSetup()
